<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:layout_marginBottom="-8dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="16dp">

                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="20dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/ic_push_pin" />

                    <TextView
                        android:id="@+id/author"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/version_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp" />

            <TextView
                android:id="@+id/desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="4"
                android:textColor="?attr/colorOutline"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/settings"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="-6dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/module_settings"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="0dp"
                    app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/size"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:maxLines="1"
                    android:maxWidth="240dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipMinHeight="28dp"
                    app:chipStrokeColor="@color/card_stroke"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/date"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:maxLines="1"
                    android:maxWidth="240dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipMinHeight="28dp"
                    app:chipStrokeColor="@color/card_stroke"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/module_update"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:maxLines="1"
                    android:text="@string/module_update_available"
                    android:textColor="@color/update_chip_text"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:chipBackgroundColor="@color/update_chip"
                    app:chipMinHeight="28dp"
                    app:chipStrokeWidth="0dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/status_disabled"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:contentDescription="@string/module_disabled"
                    android:focusable="false"
                    android:minWidth="28dp"
                    android:visibility="gone"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipEndPadding="6dp"
                    app:chipIcon="@drawable/ic_block"
                    app:chipIconSize="16dp"
                    app:chipIconTint="@color/status_red"
                    app:chipIconVisible="true"
                    app:chipMinHeight="28dp"
                    app:chipStartPadding="6dp"
                    app:chipStrokeColor="@color/card_stroke"
                    app:ensureMinTouchTargetSize="false"
                    app:iconEndPadding="0dp"
                    app:iconStartPadding="0dp"
                    app:textEndPadding="0dp"
                    app:textStartPadding="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/status_hidden"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:contentDescription="@string/module_hidden"
                    android:focusable="false"
                    android:minWidth="28dp"
                    android:visibility="gone"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipEndPadding="6dp"
                    app:chipIcon="@drawable/ic_visibility_off"
                    app:chipIconSize="16dp"
                    app:chipIconTint="@color/status_red"
                    app:chipIconVisible="true"
                    app:chipMinHeight="28dp"
                    app:chipStartPadding="6dp"
                    app:chipStrokeColor="@color/card_stroke"
                    app:ensureMinTouchTargetSize="false"
                    app:iconEndPadding="0dp"
                    app:iconStartPadding="0dp"
                    app:textEndPadding="0dp"
                    app:textStartPadding="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/status_update"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:contentDescription="@string/module_update_available"
                    android:focusable="false"
                    android:minWidth="28dp"
                    android:visibility="gone"
                    app:chipBackgroundColor="@color/update_chip"
                    app:chipEndPadding="6dp"
                    app:chipIcon="@drawable/ic_update"
                    app:chipIconSize="16dp"
                    app:chipIconTint="@color/update_chip_text"
                    app:chipIconVisible="true"
                    app:chipMinHeight="28dp"
                    app:chipStartPadding="6dp"
                    app:chipStrokeWidth="0dp"
                    app:ensureMinTouchTargetSize="false"
                    app:iconEndPadding="0dp"
                    app:iconStartPadding="0dp"
                    app:textEndPadding="0dp"
                    app:textStartPadding="0dp" />

                </com.google.android.material.chip.ChipGroup>




                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="-4dp"
                    android:contentDescription="@string/module_toggle"
                    android:scaleX="0.85"
                    android:scaleY="0.85" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
