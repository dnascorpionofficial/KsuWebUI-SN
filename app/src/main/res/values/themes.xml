<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KsuWebUI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorSurfaceContainer">@color/menu_bg</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/menu_bg</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSecondaryContainer">@color/card_stroke</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/text_hint</item>
        <item name="colorOutlineVariant">@color/divider</item>
    </style>

    <style name="Theme.KsuWebUI.WebUI">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <style name="ThemeOverlay.KsuWebUI.ButtonDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Material3.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Material3.Button.OutlinedButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Material3.Button.OutlinedButton</item>
    </style>
</resources>
